# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Environment & Secrets
.env
*.env
!.env.example

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

.claude/worktrees/

# Internal notes, never committed
*.internal.md

# Android signing material (key.properties, *.jks, *.keystore) is ignored by
# android/.gitignore, which is where those rules live. Verify with:
#   git check-ignore -v android/key.properties android/upload-keystore.jks
