# Counta Environment Configuration Template
# Copy this file to .env and fill in your values for local development:
#   cp .env.example .env

# Supabase project the app signs in to (anonymous auth) and calls the
# voice-block Edge Function on. Both values are public client configuration.
# Local stack: URL http://127.0.0.1:54321 and the anon/publishable key printed
# by `make supabase-start`.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Deepgram API key, DEV BUILDS ONLY. Read by lib/core/config/dev_secrets.dart
# for the Streaming Spike Debug screen and dev voice sessions. Release builds
# never read it; they get short-lived tokens from the voice-block function.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# RevenueCat public SDK keys, for selling minute packs. Public by design, but
# kept out of source like the rest. Without one, the app offers codes only.
REVENUECAT_IOS_KEY=appl_your_public_key_here
REVENUECAT_ANDROID_KEY=goog_your_public_key_here
