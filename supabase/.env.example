# Secrets for the voice-block Edge Function. Copy to supabase/.env for
# `supabase functions serve --env-file supabase/.env`; for a hosted project use
# `supabase secrets set --env-file supabase/.env`. Never commit supabase/.env.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the runtime and
# must not be set here.

# Deepgram master key (Member role or higher). Only ever read inside the function.
DEEPGRAM_API_KEY=
# TTL of the temporary token handed to the client. Default 30, max 3600.
DEEPGRAM_TOKEN_TTL_SECONDS=30

# RevenueCat Developer API v2 secret key with customer_information:purchases:read_write.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
# Virtual currency code configured in RevenueCat for voice credits.
REVENUECAT_CURRENCY_CODE=VOICE

# Block economics.
BLOCK_CREDITS=5
BLOCK_SECONDS=300
# A release within this many seconds of grant with zero detections is refunded.
REFUND_WINDOW_SECONDS=30

# Per-user rate limit on grants (task 8.7).
RATE_LIMIT_MAX=6
RATE_LIMIT_WINDOW_MINUTES=10

# --- Trial and vouchers (task 10). Not read by the function yet; listed so the
# --- credentials can be obtained before that work starts. Uncomment as each
# --- endpoint lands.

# Credits granted by the one-per-device trial (req 4.3).
# TRIAL_CREDITS=20

# iOS trial gate: Apple DeviceCheck. The key comes from Certificates,
# Identifiers & Profiles -> Keys, with DeviceCheck enabled; the .p8 can be
# downloaded exactly once.
# APPLE_TEAM_ID=
# APPLE_DEVICECHECK_KEY_ID=
# APPLE_DEVICECHECK_PRIVATE_KEY=
# Development-signed builds must use api.development.devicecheck.apple.com.
# The two hosts hold separate bit stores, so a device that claimed the trial
# against one has not claimed it against the other.
# APPLE_DEVICECHECK_HOST=api.devicecheck.apple.com
# Which of the team's two bits means "this device took the Counta voice trial".
# The bits belong to the Apple developer team, not to an app: check the
# allocation table in specs/voice-phrase-counting/design.md before changing it.
# DEVICECHECK_TRIAL_BIT=0

# Android trial gate: Play Integrity. Weaker than DeviceCheck by construction —
# it attests that the app and device are genuine but stores nothing per device.
# PLAY_INTEGRITY_PACKAGE_NAME=
# PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=

# Failed voucher redemptions allowed per user per window (req 12.8).
# VOUCHER_ATTEMPT_MAX=10
# VOUCHER_ATTEMPT_WINDOW_MINUTES=60
