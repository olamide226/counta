# Secrets for the voice-block Edge Function. Copy to supabase/.env for
# `supabase functions serve --env-file supabase/.env`; for a hosted project use
# `supabase secrets set --env-file supabase/.env`. Never commit supabase/.env.
#
# SUPABASE_URL, SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY and
# SUPABASE_SERVICE_ROLE_KEY are injected by the runtime and must not be set here.

# Deepgram master key (Member role or higher). Only ever read inside the function.
DEEPGRAM_API_KEY=
# TTL of the temporary token handed to the client. Default 30, max 3600.
DEEPGRAM_TOKEN_TTL_SECONDS=30

# RevenueCat Developer API v2 secret key with customer_information:purchases:read_write.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
# Virtual currency code configured in RevenueCat for voice credits.
REVENUECAT_CURRENCY_CODE=VOICE

# Provider selection. `fake` keeps balances in memory and mints dummy tokens so
# the function can be exercised before RevenueCat exists (task 10).
#   BALANCE_PROVIDER: revenuecat | fake
#   TOKEN_MINTER:     deepgram   | fake
BALANCE_PROVIDER=revenuecat
TOKEN_MINTER=deepgram
# Starting balance handed to every user by the fake balance provider.
FAKE_BALANCE_INITIAL=20

# Block economics.
BLOCK_CREDITS=5
BLOCK_SECONDS=300
# A release within this many seconds of grant with zero detections is refunded.
REFUND_WINDOW_SECONDS=30
# An existing block whose remaining life is at most this many seconds does not
# count as in-flight, so a 90% renewal (req 3.9) is not rejected with 409 (req 3.8).
RENEWAL_OVERLAP_SECONDS=30

# Per-user rate limit on grants (task 8.7).
RATE_LIMIT_MAX=6
RATE_LIMIT_WINDOW_MINUTES=10
